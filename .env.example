# ---------------------------------------------------------------------------
# NF-MUST Catalog API — environment configuration
# Copy to ".env" and adjust. All variables are prefixed with NFMUST_.
# ---------------------------------------------------------------------------

# Base URL of the GraphDB server.
#   Development : http://localhost:7200
#   Production  : http://137.194.70.195:7200
NFMUST_GRAPHDB_BASE_URL=http://localhost:7200

# Optional GraphDB basic-auth credentials (leave empty if security is off).
NFMUST_GRAPHDB_USER=
NFMUST_GRAPHDB_PASSWORD=

# Repository identifier as created in GraphDB. Every TMF entity type
# (catalog, category, candidate, generic CFSS, concrete CFSS, RFSS,
# management profile) is stored in this single repository, each instance
# isolated in its own named graph.
NFMUST_REPOSITORY=nfmust_catalog

# Named graph that holds the ontology (TBox) inside the repository.
NFMUST_ONTOLOGY_GRAPH=http://vocab.nfmust.ie/tmf-service-core/schema/ontology

# Base namespace for top-level entity / named-graph URIs. Each entity is minted
# as {graph_base_ns}{entity_type}/{local}, e.g.
#   http://vocab.nfmust.ie/tmf-service-core/service_candidate/ServiceCandidate_EMBB_001
NFMUST_GRAPH_BASE_NS=http://vocab.nfmust.ie/tmf-service-core/

# Base namespace used to mint sub-entity URIs (characteristics, values, etc.).
NFMUST_INSTANCE_NS=http://vocab.nfmust.ie/tmf-service-core/instance/

# HTTP timeout (seconds) for calls to GraphDB.
NFMUST_HTTP_TIMEOUT=30

# Enable SHACL validation before every write (recommended).
NFMUST_SHACL_ENABLED=true

# Enforce ingestion order by checking that referenced entities already exist
# before a write (RFSS -> generic CFSS -> concrete CFSS -> catalog/category/
# candidate). Disabled by default: bulk/automated ingestion (e.g. mirroring an
# external OpenSlice catalogue) does not control arrival order. Set to true to
# re-enable order enforcement.
NFMUST_REFERENCE_CHECKS_ENABLED=false

# Comma-separated list of origins allowed to call this API from a browser
# (the frontend console). Defaults already cover the Vite dev server.
# Add your deployed frontend's origin here in production, e.g.:
#   NFMUST_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://137.194.70.195:5173
NFMUST_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# Log level.
NFMUST_LOG_LEVEL=INFO
