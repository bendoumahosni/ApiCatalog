#################################################################
#    Classes
#################################################################

###  http://vocab.nfmust.ie/tmf-service-core#CFSS
tmf:CFSS rdf:type owl:Class ;
         rdfs:subClassOf tmf:ServiceSpecification ;
         rdfs:comment "Customer-Facing Service specification."@en ;
         rdfs:label "CFSS"@en .


###  http://vocab.nfmust.ie/tmf-service-core#Category
tmf:Category rdf:type owl:Class ;
             rdfs:comment "Logical/hierarchical container to organize service candidates."@en ;
             rdfs:label "Category"@en .


###  http://vocab.nfmust.ie/tmf-service-core#CharacteristicSpecification
tmf:CharacteristicSpecification rdf:type owl:Class ;
                                rdfs:comment "Characteristic/attribute of a ServiceSpecification"@en ;
                                rdfs:label "CharacteristicSpecification"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ConcreteCFSS
tmf:ConcreteCFSS rdf:type owl:Class ;
                 rdfs:subClassOf tmf:CFSS ;
                 rdfs:comment "Represents a provider-specific customer-facing service specification that specializes a generic customer-facing service specification by defining fixed or selectable characteristic values, associated pricing or commercial conditions, and links to the resource-facing service specifications required for its realization ."@en ;
                 rdfs:label "ConcreteCFSS" .


###  http://vocab.nfmust.ie/tmf-service-core#Constraint
tmf:Constraint rdf:type owl:Class ;
               rdfs:comment "constraint applied to a service specification: it  represents a policy/rule applied to an entity or entity spec."@en ;
               rdfs:label "Constraint"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ConstraintExpression
tmf:ConstraintExpression rdf:type owl:Class ;
                         rdfs:comment "Structured representation of a constraint expression using operands, operators, values, units, and optional logical connectors."@en ;
                         rdfs:label "ConstraintExpression"@en .


###  http://vocab.nfmust.ie/tmf-service-core#DeploymentArtifact
tmf:DeploymentArtifact rdf:type owl:Class ;
                       rdfs:comment "Represents the type of artifact required to instantiate, (deploy) a  service, such as an NSD file, VNFD file, TOSCA template, Helm chart, Terraform module, Ansible playbook, Kubernetes manifest"@en ;
                       rdfs:label "DeploymentArtifact"@en .


###  http://vocab.nfmust.ie/tmf-service-core#FeatureSpecification
tmf:FeatureSpecification rdf:type owl:Class ;
                         rdfs:comment "Optional: feature specification (enable only if needed)."@en ;
                         rdfs:label "FeatureSpecification"@en .


###  http://vocab.nfmust.ie/tmf-service-core#FeatureSpecificationValue
tmf:FeatureSpecificationValue rdf:type owl:Class ;
                              rdfs:comment "Optional: feature specification value (often unnecessary if using characteristics + values)."@en ;
                              rdfs:label "FeatureSpecificationValue"@en .


###  http://vocab.nfmust.ie/tmf-service-core#GenericCFSS
tmf:GenericCFSS rdf:type owl:Class ;
                rdfs:subClassOf tmf:CFSS ;
                rdfs:comment "Represents a provider-agnostic customer-facing service specification that defines the admissible characteristics, allowable value ranges, and structural dependencies  with other service specifications. It is not directly orderable and does not include provider-specific pricing information."@en ;
                rdfs:label "GenericCFSS" .


###  http://vocab.nfmust.ie/tmf-service-core#LifecycleOperation
tmf:LifecycleOperation rdf:type owl:Class ;
                       rdfs:comment "Represents a lifecycle operation that can be performed on a service, such as onboard, instantiate, deploy, configure, monitor, scale, update, heal, suspend, resume, terminate, or delete."@en ;
                       rdfs:label "Lifecycle Operation"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ManagementConstraint
tmf:ManagementConstraint rdf:type owl:Class ;
                         rdfs:comment "Represents an operational condition or prerequisite that must be satisfied before or during a lifecycle management operation, such as artifact onboarding, interface compatibility,required credentials, existing namespace."@en ;
                         rdfs:label "Management Constraint"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ManagementInterface
tmf:ManagementInterface rdf:type owl:Class ;
                        rdfs:comment "Represents the interface, tool, endpoint, or platform through which an end-to-end orchestrator can invoke lifecycle management operations, such as a REST API, CLI, SDK, Kubernetes API, Terraform CLI, Helm CLI, or NFV MANO API."@en ;
                        rdfs:label "Management Interface"@en .


###  http://vocab.nfmust.ie/tmf-service-core#RFS
tmf:RFS rdf:type owl:Class ;
        rdfs:subClassOf tmf:ServiceSpecification ;
        rdfs:comment "Resource-Facing (technical) Service specification."@en ;
        rdfs:label "RFSS"@en .


###  http://vocab.nfmust.ie/tmf-service-core#RelatedEntity
tmf:RelatedEntity rdf:type owl:Class ;
                  rdfs:comment "Represents an entity related to a service level parameter, such as the service, resource, or monitored object to which the parameter applies."@en ;
                  rdfs:label "RelatedEntity"@en .


###  http://vocab.nfmust.ie/tmf-service-core#RelatedParty
tmf:RelatedParty rdf:type owl:Class ;
                 rdfs:comment "Represents a party associated with a service catalog or a service specification, with a role such as  provider, partner ."@en ;
                 rdfs:label "RelatedParty"@en .


###  http://vocab.nfmust.ie/tmf-service-core#Resource
tmf:Resource rdf:type owl:Class ;
             rdfs:comment "Represents an instantiated or manageable resource used to realize services."@en ;
             rdfs:label "Resource"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ResourceSpecRelationship
tmf:ResourceSpecRelationship rdf:type owl:Class ;
                             rdfs:comment "Represents a reified relationship between resource specifications, preserving relationship-specific metadata such as type, role, and validity period."@en ;
                             rdfs:label "ResourceSpecRelationship"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ResourceSpecification
tmf:ResourceSpecification rdf:type owl:Class ;
                          rdfs:comment "is an abstract base class for representing a generic means for implementing a particular type of Resource. In essence, a ResourceSpecification defines the common attributes and relationships of a set of related Resources, while Resource defines a specific instance that is based on a particular ResourceSpecification"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceCandidate
tmf:ServiceCandidate rdf:type owl:Class ;
                     rdfs:comment "A service candidate exposed in a catalog."@en ;
                     rdfs:label "ServiceCandidate"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceCatalog
tmf:ServiceCatalog rdf:type owl:Class ;
                   rdfs:comment "Represents a service catalog."@en ;
                   rdfs:label "ServiceCatalog"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceLevelObjective
tmf:ServiceLevelObjective rdf:type owl:Class ;
                          rdfs:comment "Defines an objective in terms of parameters, metrics, thresholds, and tolerances."@en ;
                          rdfs:label "ServiceLevelObjective"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceLevelSpecConsequence
tmf:ServiceLevelSpecConsequence rdf:type owl:Class ;
                                rdfs:comment "Defines the consequence or prescribed action associated with the violation of a service level objective."@en ;
                                rdfs:label "ServiceLevelSpecConsequence"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceLevelSpecParameter
tmf:ServiceLevelSpecParameter rdf:type owl:Class ;
                              rdfs:comment "Defines a parameter used by a service level objective. A parameter can be one of two types:Key Quality Indicator (KQI) or Key Performance Indicator (KPI)"@en ;
                              rdfs:label "ServiceLevelSpecParameter"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceLevelSpecification
tmf:ServiceLevelSpecification rdf:type owl:Class ;
                              rdfs:comment "represents a pre-defined or negotiated set of Service Level Objectives. Service Level Agreements are expressed in terms of Service Level Specifications."@en ;
                              rdfs:label "ServiceLevelSpecification"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceManagementProfile
tmf:ServiceManagementProfile rdf:type owl:Class ;
                             rdfs:comment "Captures the minimal operational knowledge required by an end-to-end orchestrator to manage a service lifecycle, including supported lifecycle operations, the management interface to use, required deployment artifacts, and operational constraints."@en ;
                             rdfs:label "Service Management Profile"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceSpecCharacteristicValue
tmf:ServiceSpecCharacteristicValue rdf:type owl:Class ;
                                   rdfs:comment "specification of a value (number or text or an object) that can be assigned to a Characteristic."@en ;
                                   rdfs:label "ServiceSpecCharValue"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceSpecRelationship
tmf:ServiceSpecRelationship rdf:type owl:Class ;
                            rdfs:comment "Represents a reified relationship between or among service specifications, such as a dependency, substitution, or exclusivity relationship."@en ;
                            rdfs:label "ServiceSpecRelationship"@en .


###  http://vocab.nfmust.ie/tmf-service-core#ServiceSpecification
tmf:ServiceSpecification rdf:type owl:Class ;
                         rdfs:comment "ServiceSpecification is a class that offers characteristics to describe a type of service. Functionally, it acts as a template by which Services may be instantiated."@en ;
                         rdfs:label "ServiceSpecification"@en .


###  http://vocab.nfmust.ie/tmf-service-core#TimePeriod
tmf:TimePeriod rdf:type owl:Class ;
               rdfs:comment "Represents a validity period defined by a start date-time and an end date-time."@en ;
               rdfs:label "Time Period"@en .




